---
import Layout from "../layouts/Layout.astro";
import SimpleHeader from "../components/SimpleHeader.astro";
---
<Layout
  title="Search — Review Radar"
  description="Search the Review Radar directory of code quality, security, and review tools."
  noindex={true}
  breadcrumbs={[{ name: "Search", url: "/search" }]}
>
  <SimpleHeader slot="header" />
  <div class="stub-page">
    <div>
      <p class="label text-tertiary">Search</p>
      <h2 class="h2" style="margin-top: var(--space-sm);">Not built yet</h2>
      <p class="text-secondary" style="margin-top: var(--space-sm);">This is a placeholder so navigation doesn't dead-end. Preview coming in a later pass.</p>
    </div>
  </div>
</Layout>
