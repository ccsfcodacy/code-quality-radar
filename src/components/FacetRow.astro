---
import { tierLabelFor } from "../lib/tools.js";

interface Props {
  label: string;
  cell: any;
}
const { label, cell } = Astro.props;

const isObject = cell && typeof cell === "object";
const v = isObject ? cell.v : cell;
const note = isObject ? cell.note : null;
const tier = isObject && (v === "yes" || v === "partial") ? tierLabelFor(cell) : null;

const STATUS = {
  yes: { text: "Yes", cls: "status-yes" },
  partial: { text: "Partial", cls: "status-partial" },
  no: { text: "No", cls: "status-no" },
  unknown: { text: "Unknown", cls: "status-unknown" },
};
const status = STATUS[v] || STATUS.unknown;
---
<div class="facet-row">
  <div class="facet-row-head">
    <span class="facet-label">{label}</span>
    <span class={`facet-status ${status.cls}`}>{status.text}</span>
    {tier && <span class="pill facet-tier">{tier}</span>}
  </div>
  {note && <p class="facet-note">{note}</p>}
</div>
