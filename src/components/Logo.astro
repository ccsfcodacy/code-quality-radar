---
interface Props {
  href?: string;
}
const { href = "/" } = Astro.props;
---
<a href={href} class="logo">
  <svg class="logo-mark" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
    <circle cx="50" cy="50" r="32" stroke="#4AB0B5" stroke-width="6"/>
    <g class="logo-spin">
      <line x1="50" y1="50" x2="50" y2="20" stroke="#4AB0B5" stroke-width="7" stroke-linecap="round"/>
    </g>
  </svg>
  Review Radar
</a>
