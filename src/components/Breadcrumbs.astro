---
/**
 * Visible breadcrumb trail. "All tools" (the home page) is always the first
 * crumb; `trail` is everything after it. The same array drives the
 * BreadcrumbList JSON-LD in Layout, so the two cannot drift apart.
 */
interface Props {
  trail: { name: string; url: string }[];
}
const { trail } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li>
      <a href="/">All tools</a>
    </li>
    {trail.map((crumb, i) => {
      const isLast = i === trail.length - 1;
      return (
        <li>
          <span class="breadcrumb-sep" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
          </span>
          {isLast ? (
            <span class="breadcrumb-current" aria-current="page">{crumb.name}</span>
          ) : (
            <a href={crumb.url}>{crumb.name}</a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
