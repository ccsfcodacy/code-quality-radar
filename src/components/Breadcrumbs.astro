---
/**
 * Visible breadcrumb trail. Home is always the first crumb and always renders
 * as an icon; `trail` is everything after it. The same array drives the
 * BreadcrumbList JSON-LD in Layout, so the two cannot drift apart.
 */
interface Props {
  trail: { name: string; url: string }[];
}
const { trail } = Astro.props;
---
<nav class="breadcrumbs" aria-label="Breadcrumb">
  <ol>
    <li>
      <a href="/" class="breadcrumb-home" aria-label="Home">
        <svg viewBox="2 2 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 10.5 12 3l9 7.5" />
          <path d="M5.5 9.5V20h13V9.5" />
        </svg>
      </a>
    </li>
    {trail.map((crumb, i) => {
      const isLast = i === trail.length - 1;
      return (
        <li>
          <span class="breadcrumb-sep" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6" /></svg>
          </span>
          {isLast ? (
            <span class="breadcrumb-current" aria-current="page">{crumb.name}</span>
          ) : (
            <a href={crumb.url}>{crumb.name}</a>
          )}
        </li>
      );
    })}
  </ol>
</nav>
