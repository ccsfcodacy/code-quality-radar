{
  // Static-site deployment via Cloudflare Workers' assets feature — no Worker
  // script needed, Cloudflare serves the Astro build output directly.
  // https://developers.cloudflare.com/workers/static-assets/
  "name": "review-radar",
  "compatibility_date": "2026-09-07",
  "assets": {
    "directory": "./dist"
  }
}
